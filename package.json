{
  "name": "pi-batch-runner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "pi 批处理扩展：在单个 TUI 窗口中顺序执行清单文件中的多个提示词任务",
  "keywords": [
    "pi",
    "extension",
    "batch",
    "tui",
    "prompts"
  ],
  "author": {
    "name": "RanFR",
    "url": "https://github.com/RanFR"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "node scripts/verify-formatting.ts --verify",
    "format": "node scripts/verify-formatting.ts --replace",
    "pack": "bash scripts/pack.sh"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
