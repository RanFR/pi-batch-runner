#!/bin/sh
# Pre-commit hygiene: lint + format-check the staged files.
# Bypass with `git commit --no-verify`.

staged_ts=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.js')
[ -z "$staged_ts" ] && exit 0

echo "Running ESLint on staged files..."
npx eslint --no-warn-ignored $staged_ts || exit 1

echo "Running Prettier check on staged files..."
npx prettier --check $staged_ts || {
	echo "Files not formatted. Run 'npm run format' and re-stage."
	exit 1
}
